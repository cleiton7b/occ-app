PORT=3001

# (Opcional) Caminho do certificado CA corporativa (Netskope/ZTNA) para redes com inspeção TLS.
# Se não informado, o app procura automaticamente por netskope-root.cer / ca-root.cer ao lado do executável
# ou em C:\temp\netskope-root.cer.
# CA_CERT_PATH=C:\temp\netskope-root.cer
# Origens permitidas para CORS (separadas por vírgula). Padrão: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# STAGE Environment (HML)
ENV1=STAGE_APCS
TENANT=your_stage_tenant
BASE_URL=https://rap-npe.retail.sa-vinhedo-1.ocs.oraclecloud.com
IDCS_URL=https://idcs-your-instance.identity.oraclecloud.com/oauth2/v1/token
IDCS_CLIENTID=your_stage_client_id
IDCS_CLIENTSECRET=your_stage_client_secret
IDCS_SCOPE=urn:opc:idm:__myscopes__

# DEV Environment
ENV2=DEV_APCS
TENANT=your_dev_tenant
BASE_URL=https://rap-npe.retail.sa-vinhedo-1.ocs.oraclecloud.com
IDCS_URL=https://idcs-your-instance.identity.oraclecloud.com/oauth2/v1/token
IDCS_CLIENTID=your_dev_client_id
IDCS_CLIENTSECRET=your_dev_client_secret
IDCS_SCOPE=urn:opc:idm:__myscopes__

# Voce pode adicionar quantos ambientes quiser seguindo a sequencia ENV3, ENV4, etc:
# ENV3=PROD_APCS
# TENANT=...
# BASE_URL=...
# IDCS_URL=...
# IDCS_CLIENTID=...
# IDCS_CLIENTSECRET=...
# IDCS_SCOPE=...
